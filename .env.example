DB_NAME=simulador
DB_USER=simulador
DB_PASSWORD=cambiar_esta_clave
# Puerto del host para PostgreSQL. Si el 5432 está ocupado en tu máquina,
# usá otro (ej. 5433) y, para correr el backend local sin Docker, poné
# el mismo valor en DB_PORT.
DB_HOST_PORT=5432
DB_PORT=5432
APP_PORT=8080
# Reservado para la integración futura con el SSO de la facultad.
# Todavía no se usa en el código.
JWT_SECRET=cambiar_por_una_clave_larga_de_al_menos_32_caracteres
